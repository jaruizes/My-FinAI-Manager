<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!--
      EN001 — Bootstrap Executable Platform.
      Single coarse-grained backend deployable component (ADR-001).
      Versions decided by a maintainer in specs/EN001-bootstrap-platform/research.md:
        Java 21 LTS · Spring Boot 3.5.x · Maven · Flyway · Testcontainers (PostgreSQL).
      No business schema, no business API, no Spring Security. Real domain modules arrive with FD001.
    -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.6</version>
        <relativePath/>
    </parent>

    <groupId>com.myfinaimanager</groupId>
    <artifactId>core-service</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>core-service</name>
    <description>My-FinAI-Manager platform backend (EN001 bootstrap baseline)</description>

    <properties>
        <java.version>21</java.version>
        <archunit.version>1.3.0</archunit.version>
        <swagger-request-validator.version>2.44.1</swagger-request-validator.version>
        <commons-csv.version>1.12.0</commons-csv.version>
        <!--
          Docker API version for the Testcontainers integration test. Testcontainers 1.21.3
          (managed by the Spring Boot BOM) bundles a shaded docker-java that, when the API version
          is not configured, falls back to sending client version 1.32. Modern Docker Engines
          (Docker Desktop / OrbStack / colima / Rancher Desktop / recent Linux + CI) enforce a
          minimum API version of 1.44 and reject 1.32 with HTTP 400 ("client version 1.32 is too
          old"). Pinning a supported version here makes `mvn verify` work everywhere. Bump this if
          a future engine raises its minimum. See src/test/.../PostgresContainerSupport.java.
        -->
        <testcontainers.docker.api.version>1.44</testcontainers.docker.api.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <!--
          EN006 / research D1: the platform's first OpenTelemetry telemetry-export dependency
          (`OpenTelemetry` is `PREFERRED` per technology-policy.md). Spring Boot's own
          Micrometer-Tracing + OTLP-exporter path — no direct opentelemetry-sdk wiring. Versions
          come from spring-boot-starter-parent's dependency management (no explicit <version>).
        -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-tracing-bridge-otel</artifactId>
        </dependency>
        <dependency>
            <groupId>io.opentelemetry</groupId>
            <artifactId>opentelemetry-exporter-otlp</artifactId>
        </dependency>
        <!-- The OTLP *metrics* registry (distinct from the trace exporter above) — without this,
             management.otlp.metrics.* has nothing to bind an OtlpMeterRegistry to and metrics are
             silently never exported (found during EN006 runtime verification). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-otlp</artifactId>
        </dependency>
        <!--
          EN003 / ADR-003: Spring Data JPA is the standard relational-persistence abstraction for
          Spring components. Portfolio persistence uses Spring Data JPA; Flyway keeps owning the
          schema (spring.jpa.hibernate.ddl-auto = none). spring-jdbc / JdbcClient remain on the
          classpath transitively (used only by test-support code — OD-EN003-9).
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>

        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!--
          EN004: RFC 4180 CSV parsing for the financialinstrument reference-data ingestion adapter.
          Leaf utility, used ONLY inside financialinstrument.infrastructure.reference.csv (ArchUnit
          forbids org.apache.commons.csv outside that module's infrastructure). Apache-2.0, no
          transitive deps. See specs/EN004-.../research.md D12.
        -->
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-csv</artifactId>
            <version>${commons-csv.version}</version>
        </dependency>

        <!-- Tests -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- EN006: TCK assertions for AiTelemetryRecorderTest (Micrometer Observation spans). -->
        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-observation-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.tngtech.archunit</groupId>
            <artifactId>archunit-junit5</artifactId>
            <version>${archunit.version}</version>
            <scope>test</scope>
        </dependency>
        <!--
          Contract test (FD001, AR-011): validates live request/response payloads against
          implementation/platform/contracts/openapi/openapi.yaml so the contract cannot drift.
        -->
        <dependency>
            <groupId>com.atlassian.oai</groupId>
            <artifactId>swagger-request-validator-mockmvc</artifactId>
            <version>${swagger-request-validator.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>

            <!--
              Make the platform OpenAPI contract available to the contract test on the test
              classpath (as `openapi.yaml`), so the test validates against the single source of
              truth without a brittle relative path (FD001 AR-011).
            -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>
                    <execution>
                        <id>copy-platform-openapi-contract</id>
                        <phase>generate-test-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.testOutputDirectory}</outputDirectory>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/../../contracts/openapi</directory>
                                    <includes>
                                        <include>openapi.yaml</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Unit tests: *Test / *Tests -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/*Test.java</include>
                        <include>**/*Tests.java</include>
                    </includes>
                    <excludes>
                        <exclude>**/*IT.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!-- Integration tests: *IT (bound to the integration-test / verify phases) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
                <configuration>
                    <includes>
                        <include>**/*IT.java</include>
                    </includes>
                    <systemPropertyVariables>
                        <!-- Read by (shaded) docker-java in Testcontainers; see property comment above. -->
                        <api.version>${testcontainers.docker.api.version}</api.version>
                    </systemPropertyVariables>
                </configuration>
            </plugin>

            <!-- Coverage (report only; no enforced gate in EN001 — no behavioral code yet) -->
            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                    <!-- FD001 (DoD §5): enforce the coverage gate now that the platform has behavioural code. -->
                    <execution>
                        <id>check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <rule>
                                    <element>BUNDLE</element>
                                    <limits>
                                        <limit>
                                            <counter>LINE</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                        <limit>
                                            <counter>BRANCH</counter>
                                            <value>COVEREDRATIO</value>
                                            <minimum>0.90</minimum>
                                        </limit>
                                    </limits>
                                </rule>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
                <configuration>
                    <excludes>
                        <exclude>com/myfinaimanager/core/CoreServiceApplication.class</exclude>
                        <exclude>com/myfinaimanager/core/portfolio/infrastructure/config/**</exclude>
                        <!-- Declarative JPA mapping structures (no business logic): equals/hashCode
                             on id, getters. Behaviour is covered by the persistence ITs. -->
                        <exclude>com/myfinaimanager/core/portfolio/infrastructure/persistence/entity/**</exclude>
                        <!-- EN004: same rationale for the financialinstrument module. -->
                        <exclude>com/myfinaimanager/core/financialinstrument/infrastructure/config/**</exclude>
                        <exclude>com/myfinaimanager/core/financialinstrument/infrastructure/persistence/entity/**</exclude>
                        <!-- EN005: same rationale for the marketdata module — typed config/wiring
                             (no branch logic) and pure Jackson provider DTO records. Behaviour is
                             covered by FinnhubConfigurationTest and the mapper/adapter tests. -->
                        <exclude>com/myfinaimanager/core/marketdata/infrastructure/config/**</exclude>
                        <exclude>com/myfinaimanager/core/marketdata/infrastructure/finnhub/dto/**</exclude>
                        <!-- EN005 Revision 2: Frankfurter FX provider DTOs; financialinstrument
                             instrument-profile provider DTOs + typed provider config. -->
                        <exclude>com/myfinaimanager/core/marketdata/infrastructure/frankfurter/dto/**</exclude>
                        <exclude>com/myfinaimanager/core/financialinstrument/infrastructure/finnhub/dto/**</exclude>
                        <exclude>com/myfinaimanager/core/financialinstrument/infrastructure/finnhub/config/**</exclude>
                        <!-- FD005: same rationale for the portfolioanalysis module's JPA entities. -->
                        <exclude>com/myfinaimanager/core/portfolioanalysis/infrastructure/persistence/entity/**</exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
