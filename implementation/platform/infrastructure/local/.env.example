# EN001 local infrastructure configuration — SYNTHETIC, non-production values only.
#
# Copy to `.env` (git-ignored) before running implementation/platform/start.sh:
#   cp infrastructure/local/.env.example infrastructure/local/.env
#
# These are NOT secrets. Never put real credentials in this file or in `.env` (DR-033, AR-037).

POSTGRES_DB=finai
POSTGRES_USER=finai
POSTGRES_PASSWORD=finai_local_dev
POSTGRES_PORT=5432

# Backend datasource (defaults in application.yml already match the values above; override here
# if you change the port or database name).
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/finai
SPRING_DATASOURCE_USERNAME=finai
SPRING_DATASOURCE_PASSWORD=finai_local_dev
