# Local platform configuration — SYNTHETIC, non-production values only.
#
# Copy to `.env` (git-ignored) before running implementation/platform/start.sh:
#   cp infrastructure/local/.env.example infrastructure/local/.env
#
# These are NOT secrets. Never put real credentials in this file or in `.env` (DR-033, AR-037).
# After EN002 the whole platform runs as containers (Docker Compose); there is no host
# Spring Boot / Angular process.

# --- PostgreSQL (the `postgres` Compose service) ---
POSTGRES_DB=finai
POSTGRES_USER=finai
POSTGRES_PASSWORD=finai_local_dev

# Host port the `postgres` service is published on (container port is always 5432).
POSTGRES_PORT=5432

# --- Backend (the `backend` Compose service) ---
# The datasource host is the Compose SERVICE NAME `postgres`, not `localhost` — the backend now
# runs inside the Compose network.
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/finai
SPRING_DATASOURCE_USERNAME=finai
SPRING_DATASOURCE_PASSWORD=finai_local_dev

# --- Image / version pins ---
# Base-image and framework tags are BUILD CONFIGURATION (see compose.yaml build args), never
# secrets. They are pinned in compose.yaml / the Dockerfiles, not overridden here by default.
