{
  "title": "AI Observability (EN006)",
  "uid": "en006-ai-observability",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "timezone": "browser",
  "time": { "from": "now-1h", "to": "now" },
  "tags": ["en006", "ai"],
  "panels": [
    {
      "id": 1,
      "title": "Request Volume",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "sum(rate(ai_requests_total[5m])) by (task)", "legendFormat": "{{task}}" },
        { "expr": "sum(rate(ai_requests_total[5m])) by (provider, model)", "legendFormat": "{{provider}}/{{model}}" }
      ]
    },
    {
      "id": 2,
      "title": "Latency (avg / p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        {
          "expr": "sum(rate(ai_request_duration_milliseconds_sum[5m])) by (provider, model) / sum(rate(ai_request_duration_milliseconds_count[5m])) by (provider, model)",
          "legendFormat": "avg {{provider}}/{{model}} (ms)"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(ai_request_duration_milliseconds_bucket[5m])) by (le, provider, model))",
          "legendFormat": "p95 {{provider}}/{{model}} (ms)"
        }
      ]
    },
    {
      "id": 3,
      "title": "Token Usage",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [
        { "expr": "sum(rate(ai_input_tokens_total[5m])) by (task)", "legendFormat": "input {{task}}" },
        { "expr": "sum(rate(ai_output_tokens_total[5m])) by (task)", "legendFormat": "output {{task}}" },
        { "expr": "sum(rate(ai_input_tokens_total[5m])) by (model)", "legendFormat": "input {{model}}" },
        { "expr": "sum(rate(ai_output_tokens_total[5m])) by (model)", "legendFormat": "output {{model}}" }
      ]
    },
    {
      "id": 4,
      "title": "Estimated Cost",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "description": "Renders as 0/empty (never an error) when no cost data is available — e.g. the shipped local/stub adapter, which reports zero cost by design (EN006 resolved Q1).",
      "fieldConfig": { "defaults": { "noValue": "0" }, "overrides": [] },
      "targets": [
        { "expr": "sum(rate(ai_estimated_cost_total[5m])) by (task)", "legendFormat": "{{task}}" },
        { "expr": "sum(rate(ai_estimated_cost_total[5m])) by (provider, model)", "legendFormat": "{{provider}}/{{model}}" }
      ]
    },
    {
      "id": 5,
      "title": "Errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "targets": [
        { "expr": "sum(rate(ai_errors_total[5m])) by (error)", "legendFormat": "{{error}}" }
      ]
    },
    {
      "id": 6,
      "title": "Guardrail Activity",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "targets": [
        {
          "expr": "sum(rate(ai_guardrail_rejections_total[5m])) by (direction, guardrail)",
          "legendFormat": "{{direction}}/{{guardrail}}"
        },
        {
          "expr": "sum(rate(ai_guardrail_rejections_total[5m])) / sum(rate(ai_requests_total[5m]))",
          "legendFormat": "rejection rate"
        }
      ]
    },
    {
      "id": 7,
      "title": "Model Usage",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "targets": [
        { "expr": "sum(ai_requests_total) by (provider)", "legendFormat": "{{provider}}" },
        { "expr": "sum(ai_requests_total) by (model)", "legendFormat": "{{model}}" }
      ]
    }
  ]
}
